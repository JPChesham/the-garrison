# Deploy with: doctl serverless connect the-garrison && doctl serverless deploy digitalocean-functions
# Place this file as digitalocean-functions/.env (do not commit secrets).

# Comma-separated browser origins allowed to call the fixtures function
ALLOWED_ORIGINS=https://thegarrison.co.uk,https://www.thegarrison.co.uk,http://localhost:3000

# Register free at https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
